# Public URLs (use HTTPS public URLs in production)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Set to "live" only after merchant approval and production testing.
PAYMENT_MODE=test

# eSewa merchant credentials
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=replace-with-your-esewa-secret

# Khalti ePayment merchant secret key
KHALTI_SECRET_KEY=replace-with-your-khalti-secret-key
